# Live mode: your Intervals.icu API key (Settings -> Developer Settings)
COACH_INTERVALS_API_KEY=
# Offline mode: comment the key and point to frozen data instead
# COACH_FIXTURES_PATH=evals/synthetic/build_week.json
COACH_THRESHOLD_PACE_SEC_PER_KM=310
# Python agent runner (coach-week and the evals). Not needed by the MCP server or by /week.
ANTHROPIC_API_KEY=
# Logfire write token. Without it, no trace leaves this machine.
LOGFIRE_TOKEN=
# Debug only: writes prompts and outputs to logs/debug-traces.jsonl and sends nothing to Logfire.
COACH_LOG_CONTENT=false
